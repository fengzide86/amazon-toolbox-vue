# Local-only credentials used by deployment scripts.
# Copy to .env.deploy. Never commit the real file.

DEPLOY_SERVER_HOST=your-server.example
DEPLOY_SERVER_USER=deploy
DEPLOY_SSH_KEY_FILE=~/.ssh/amazon_toolbox_ed25519
DEPLOY_REMOTE_DIR=/opt/amazon-toolbox
DEPLOY_UPDATE_DIR=/opt/amazon-toolbox/backend/updates

# Password authentication is a temporary fallback. Prefer an SSH key/agent.
# DEPLOY_SERVER_PASSWORD=

# Required only by legacy database maintenance scripts.
# DEPLOY_MYSQL_ROOT_PASSWORD=
# DEPLOY_MYSQL_PASSWORD=

# Temporary secure handoff for replacing a cloud AI key. Remove after upload.
# QWEN_API_KEY=
