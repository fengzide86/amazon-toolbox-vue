# Docker Compose server configuration.
# Copy to /opt/amazon-toolbox/.env and replace every placeholder.

MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
MYSQL_DATABASE=toolbox
MYSQL_USER=toolbox_user
MYSQL_PASSWORD=replace-with-a-unique-app-password

JWT_SECRET_KEY=replace-with-at-least-48-random-characters
DEFAULT_ADMIN_PASSWORD=replace-before-first-start
CORS_ORIGINS=https://your-domain.example

# Ed25519 raw keys encoded as Base64. Keep the private key only on the control plane.
TOOL_SIGNING_PRIVATE_KEY_B64=replace-with-generated-private-key
TOOL_SIGNING_PUBLIC_KEY_B64=replace-with-generated-public-key
TOOL_SIGNING_KEY_ID=tool-signing-v1
