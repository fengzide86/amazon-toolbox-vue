{
  "name": "amazon-toolbox",
  "version": "1.8.0",
  "description": "面向跨境电商业务的桌面自动化效率工具箱",
  "author": "Amazon Toolbox Team",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/desktop-main.cjs",
  "toolbox": {
    "controlApiUrl": "https://8.130.113.104",
    "distribution": "internal",
    "automationRuntime": true
  },
  "scripts": {
    "dev": "vite --mode development",
    "build:web": "vite build --mode production",
    "build": "set \"TEMP=D:\\AmazonToolboxData\\build-tmp\"&& set \"TMP=D:\\AmazonToolboxData\\build-tmp\"&& vite build --mode production",
    "build:desktop": "set \"TOOLBOX_BUILD_TARGET=electron\"&& set \"TEMP=D:\\AmazonToolboxData\\build-tmp\"&& set \"TMP=D:\\AmazonToolboxData\\build-tmp\"&& vite build --mode production",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.build.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "backend:build": "cd backend && python -m PyInstaller --noconfirm --clean --distpath build\\dist --workpath build\\work toolbox-backend.spec && copy /Y build\\dist\\toolbox-backend.exe ..\\electron\\toolbox-backend.exe",
    "electron:build": "npm run electron:compile && npm run build:desktop && set \"ELECTRON_CACHE=D:\\AmazonToolboxData\\electron-cache\"&& set \"ELECTRON_BUILDER_CACHE=D:\\AmazonToolboxData\\electron-builder-cache\"&& set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win nsis",
    "release:validate": "tsx scripts/validate-release-env.ts",
    "electron:release": "npm run release:validate && npm run electron:compile && npm run build:desktop && set \"ELECTRON_CACHE=D:\\AmazonToolboxData\\electron-cache\"&& set \"ELECTRON_BUILDER_CACHE=D:\\AmazonToolboxData\\electron-builder-cache\"&& set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis",
    "electron:preview": "npm run electron:compile && electron .",
    "test": "npm run electron:compile && npm run test:unit && npm run test:electron-workflow",
    "test:run": "npm test",
    "test:unit": "vitest run --exclude src/tests/electron/automationWorkflow.test.ts",
    "test:electron-workflow": "vitest run src/tests/electron/automationWorkflow.test.ts --maxWorkers=1 --fileParallelism=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude src/tests/electron/automationWorkflow.test.ts && npm run test:electron-workflow",
    "test:backend": "python -m pytest backend --rootdir=backend -q",
    "test:e2e": "set \"PLAYWRIGHT_BROWSERS_PATH=D:\\AmazonToolboxData\\playwright-browsers\"&& playwright test",
    "test:e2e:business": "set \"PLAYWRIGHT_BROWSERS_PATH=D:\\AmazonToolboxData\\playwright-browsers\"&& playwright test --config=playwright.business.config.ts",
    "test:e2e:internal": "set \"PLAYWRIGHT_BROWSERS_PATH=D:\\AmazonToolboxData\\playwright-browsers\"&& playwright test --config=playwright.internal.config.ts",
    "test:e2e:capture": "set \"PLAYWRIGHT_BROWSERS_PATH=D:\\AmazonToolboxData\\playwright-browsers\"&& playwright test --config=playwright.capture.config.ts",
    "test:embedded-browser": "npm run electron:compile && electron dist-electron/electron/smoke/embedded-browser-smoke.cjs",
    "test:amazon-navigation": "npm run electron:compile && electron dist-electron/electron/smoke/amazon-navigation-smoke.cjs",
    "test:app-protocol": "npm run electron:compile && electron dist-electron/electron/smoke/app-protocol-smoke.cjs",
    "test:automation-smoke": "npm run electron:compile && node scripts/automation-smoke.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.ts\" \"electron/**/*.{ts,cts}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "security:audit": "python scripts/audit_secrets.py",
    "security:audit-history": "python scripts/audit_secrets.py --history",
    "deadcode": "tsx scripts/audit-dead-code.ts",
    "package:audit": "tsx scripts/audit-desktop-package.ts",
    "docker:config": "docker compose --env-file .env.docker -f compose.yaml config",
    "docker:up": "docker compose --env-file .env.docker -f compose.yaml up -d --build --wait",
    "docker:down": "docker compose --env-file .env.docker -f compose.yaml down",
    "docker:logs": "docker compose --env-file .env.docker -f compose.yaml logs --tail=200 -f api",
    "docker:test:mariadb": "docker compose --env-file .env.docker -f compose.yaml --profile test run --rm backend-tests",
    "build:verify": "npm run build && tsx scripts/verify-build.ts",
    "verify:backend": "python -m pytest backend --rootdir=backend -q && python -m ruff check backend/domains/auth backend/domains/knowledge backend/domains/catalog backend/core/deprecation.py backend/app/lifecycle.py backend/routers/auth.py backend/routers/ai_chat.py backend/routers/knowledge.py backend/routers/help.py backend/routers/tools.py backend/routers/announcements.py backend/routers/updates.py && python -m mypy --config-file backend/pyproject.toml backend/app backend/domains",
    "verify:quick": "npm test && npm run test:backend",
    "verify": "npm run security:audit && npm run typecheck && npm run lint -- --max-warnings=0 && npm run deadcode && npm test && npm run build:desktop && npm run verify:backend"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "playwright-core": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@lucide/vue": "^1.21.0",
    "@playwright/test": "^1.61.0",
    "@sentry/vue": "^10.57.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.8.1",
    "element-plus": "^2.14.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.2",
    "jsdom": "^29.1.1",
    "pinia": "^3.0.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.48.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.amazon.toolbox",
    "productName": "跨境电商赛训效率工具箱",
    "artifactName": "AmazonToolbox Setup ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "extraFiles": [],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "**/*.xlsx"
        ]
      },
      {
        "from": "resources/rates",
        "to": "rates",
        "filter": [
          "**/*.xlsx"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.cts",
      "!dist-electron/electron/smoke/**",
      "!**/test/**",
      "!**/tests/**",
      "!**/*.md"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "亚马逊工具箱"
    },
    "publish": {
      "provider": "generic",
      "url": "https://8.130.113.104/updates/",
      "channel": "latest"
    }
  }
}
