# ===== 亚马逊赛训效率工具箱 - 前端环境变量配置 =====
# 复制此文件为 .env.development 并修改配置

# 云端控制面 API 地址
# 开发环境：http://localhost:8000
# 生产环境必须使用配置了证书和域名的 HTTPS 地址，不要通过公网 HTTP 发送 JWT。
VITE_CONTROL_API_BASE=http://localhost:8000
# 旧变量保留到桌面端迁移完成
VITE_API_BASE=http://localhost:8000

# Electron 主进程使用：远程 HTTPS 地址启用后会自动跳过内嵌 Python 后端
# TOOLBOX_CONTROL_API_URL=https://api.example.com
# TOOLBOX_USE_BUNDLED_BACKEND=false

# 环境标识
# development: 开发环境
# production: 生产环境
VITE_ENV=development
